{
  "name": "commerce-saga-frontend",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "lint": "eslint apps packages",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write apps packages",
    "format:check": "prettier --check apps packages",
    "dev:admin": "pnpm --filter admin dev",
    "dev:auth": "pnpm --filter auth dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0"
  }
}
