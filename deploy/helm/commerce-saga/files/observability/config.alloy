// 수집기 (ADR 0013). trace·로그·메트릭을 모두 여기서 모아 저장소로 나눈다
//   trace  : 서비스 ──OTLP push──▶ Alloy ──▶ Tempo
//   로그   : 서비스 ──OTLP push──▶ Alloy ──▶ Loki
//   메트릭 : Alloy ──scrape(pull)──▶ 서비스·kafka-exporter·관측성 스택 ──remote_write──▶ Prometheus (저장·경보)
// 서비스는 수집기 주소(OTLP_TRACING_ENDPOINT·OTLP_LOGGING_ENDPOINT)만 알고, 저장소를 바꿔도 서비스 설정은 그대로다.
// compose 와 k8s 가 이 파일을 같이 쓴다(차트 files/observability 사본). 환경마다 다른 것은 환경 변수로 받고,
// k8s 에만 있는 수집(노드의 컨테이너 메모리)은 차트가 같은 폴더에 kubernetes.alloy 로 더 넣는다

// ───────────── 메트릭 ─────────────
// Alloy 가 긁어도 pull 이라 죽은 대상은 up=0 으로 남는다(경보 ServiceDown). Alloy 자체가 멈추면 아무것도 들어오지 않으므로
// Prometheus 가 up{job="alloy"} 가 사라진 것을 경보로 본다(MetricsPipelineDown)
prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// 서비스 7개 /actuator/prometheus: Saga·결제·outbox 메트릭(commerce_*), JVM, HTTP, Kafka 클라이언트.
// 주소가 환경마다 달라(compose: host.docker.internal:<포트>, k8s: <Service>:<포트>) JSON 으로 받는다
//   METRICS_SERVICE_TARGETS='[{"__address__":"order-service:8081","service":"order-service"}, ...]'
prometheus.scrape "services" {
  targets         = encoding.from_json(sys.env("METRICS_SERVICE_TARGETS"))
  job_name        = "services"
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "5s"
  scrape_timeout  = "5s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// 컨슈머 그룹 lag, 토픽 끝 오프셋(DLT 적재 확인). 서비스가 죽어 있어도 브로커 기준으로 보인다
prometheus.scrape "kafka" {
  targets         = [{"__address__" = "kafka-exporter:9308"}]
  job_name        = "kafka"
  scrape_interval = "5s"
  scrape_timeout  = "5s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// 관측성 스택 자신(메모리·수집량·오류). 수집기·저장소가 죽거나 한도에 닿으면 trace·로그가 조용히 사라지므로 따로 본다.
// 15s 로 둔다: 기본 60s 면 MetricsPipelineDown(1분 동안 up{job="alloy"} 없음)이 수집 사이 틈에 잘못 울릴 수 있다
prometheus.scrape "tempo" {
  targets         = [{"__address__" = "tempo:3200"}]
  job_name        = "tempo"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.scrape "loki" {
  targets         = [{"__address__" = "loki:3100"}]
  job_name        = "loki"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.scrape "alertmanager" {
  targets         = [{"__address__" = "alertmanager:9093"}]
  job_name        = "alertmanager"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.scrape "prometheus" {
  targets         = [{"__address__" = "prometheus:9090"}]
  job_name        = "prometheus"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// 내장 exporter 는 job="integrations/…" 를 스스로 붙여 job_name 으로 바뀌지 않는다 → 경보가 쓰는 이름으로 바꾼다
prometheus.exporter.self "alloy" { }

discovery.relabel "alloy" {
  targets = prometheus.exporter.self.alloy.targets

  rule {
    target_label = "job"
    replacement  = "alloy"
  }
}

prometheus.scrape "alloy" {
  targets         = discovery.relabel.alloy.output
  job_name        = "alloy"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// ───────────── trace·로그 ─────────────

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    traces = [otelcol.processor.tail_sampling.default.input]
    logs   = [otelcol.processor.batch.default.input]
  }
}

// trace 샘플링은 여기서 한다(tail sampling). 서비스는 전부 보내고(샘플링 1.0), 끝난 trace 를 보고 남길지 정한다.
// 오류(span ERROR·5xx)·느린 trace 는 비율과 상관없이 남기고, actuator(헬스 체크·메트릭 수집) trace 는 버린다.
// 나머지는 TRACE_SAMPLING_PERCENT(%, 기본 100)만큼. trace id 로 정하므로 같은 trace 의 늦은 span 도 같은 결정을 받는다.
// 로그는 샘플링하지 않는다. 버린 trace 의 로그도 Loki 에는 남는다(그 trace 를 열면 비어 있다)
otelcol.processor.tail_sampling "default" {
  // 첫 span 이 온 뒤 이만큼 모았다가 판단한다. 그동안 Tempo 에 보이지 않는다(시나리오 11 은 60초까지 기다린다).
  // 나머지 비율이 100% 면 결과가 같아 짧게 둔다. 비율을 낮추면 30s 로 올린다: 결제 지연·타임아웃처럼 오래 걸린 Saga 는
  // 판단 뒤에 오류 span 이 와서, 앞부분은 버려지고 오류 조각만 남을 수 있다
  // (klmin-drive 실측: 10s 에서 5xx 31건 중 5건 유실 → 30s)
  // 남기기로 한 trace 의 늦은 span(늦게 끝난 Saga 단계)은 decision_cache 를 보고 그대로 남긴다.
  // 버린 trace 의 늦은 span 은 다시 판단한다: 비율은 trace id 로 정해 결과가 같고, 늦게 난 오류는 남는다
  decision_wait = "10s"

  decision_cache = {
    sampled_cache_size = 10000,
  }

  policy {
    name = "drop-actuator"
    type = "drop"

    drop {
      drop_sub_policy {
        name = "actuator"
        type = "string_attribute"

        string_attribute {
          key                    = "uri"
          values                 = ["/actuator/.*"]
          enabled_regex_matching = true
        }
      }
    }
  }

  policy {
    name = "errors"
    type = "status_code"

    status_code {
      status_codes = ["ERROR"]
    }
  }

  // @ExceptionHandler 가 잡아 Problem Details 로 답한 5xx 는 span 이 ERROR 가 아니다. Spring 이 남기는 outcome 으로 잡는다.
  // 4xx(검증 실패·인증·남의 주문·재고 부족)는 서버가 정상으로 거절한 것이라 남기지 않는다. 건수는 Prometheus 메트릭으로 본다
  policy {
    name = "server_errors"
    type = "string_attribute"

    string_attribute {
      key    = "outcome"
      values = ["SERVER_ERROR"]
    }
  }

  policy {
    name = "slow"
    type = "latency"

    latency {
      threshold_ms = 1000
    }
  }

  policy {
    name = "rest"
    type = "probabilistic"

    probabilistic {
      sampling_percentage = encoding.from_json(coalesce(sys.env("TRACE_SAMPLING_PERCENT"), "100"))
    }
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
    logs   = [otelcol.exporter.otlphttp.loki.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
  }
}

// Loki 3 는 OTLP 를 그대로 받는다 (/otlp/v1/logs). service.name → 라벨 service_name, trace_id·span_id → structured metadata
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}
