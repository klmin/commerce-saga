{
  "uid": "commerce-saga",
  "title": "commerce-saga",
  "description": "Saga 진행·완료, HTTP, JVM, 컨테이너, 결제 보정·Kafka lag·DLT·outbox relay (ADR 0013). 경보 규칙은 infra/prometheus/rules",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "commerce-saga"
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "지금 firing 중인 경보",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "진행 중 Saga (단계별)",
      "datasource": {
