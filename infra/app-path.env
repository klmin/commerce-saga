# 경로 방식으로 전체 실행할 때 (infra/docker-compose.app.yml 머리 주석). 한 주소 http://localhost 에 /, /admin/, /auth/
CADDY_MODE=path
PUBLIC_WEB_URL=http://localhost
PUBLIC_ADMIN_URL=http://localhost/admin
PUBLIC_AUTH_URL=http://localhost/auth
# 경로 방식은 로그인 클라이언트 하나(gateway-web) → 관리자 호스트로 고르지 않는다 (설계 문서 7-4)
ADMIN_CLIENT_HOST=
GATEWAY_WEB_HOME=/
GATEWAY_ADMIN_HOME=/admin/
# 관리자 화면도 gateway-web 으로 로그인하므로 로그아웃 뒤 /admin/ 도 등록한다
WEB_POST_LOGOUT_REDIRECT_URIS=http://localhost/,http://localhost/admin/
ADMIN_BASE_PATH=/admin/
