{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "plugin.name": "pgoutput",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "product_svc",
  "database.password": "${env:PRODUCT_DB_PASSWORD}",
  "database.dbname": "product_db",
  "topic.prefix": "product-cdc",
  "table.include.list": "public.products",
  "column.include.list": "public.products.id,public.products.name,public.products.description,public.products.price,public.products.on_sale,public.products.updated_at",
  "slot.name": "product_cdc_slot",
  "publication.name": "product_cdc_pub",
  "publication.autocreate.mode": "filtered",
  "snapshot.mode": "initial",
  "poll.interval.ms": "100",
  "heartbeat.interval.ms": "10000",
  "heartbeat.action.query": "select pg_logical_emit_message(false, 'heartbeat', now()::varchar)",
  "message.prefix.exclude.list": "heartbeat",
  "tombstones.on.delete": "true",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "header.converter": "org.apache.kafka.connect.storage.SimpleHeaderConverter",
  "transforms": "unwrap,key,route",
  "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
  "transforms.unwrap.delete.tombstone.handling.mode": "tombstone",
  "transforms.unwrap.add.headers": "lsn,source.ts_ms",
  "transforms.key.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
  "transforms.key.field": "id",
  "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.route.regex": "product-cdc\\.public\\.products",
  "transforms.route.replacement": "product.cdc.products"
}
